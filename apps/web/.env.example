# Supabase — public values, safe to ship in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase — server-only. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared secret guarding the on-demand revalidation route
REVALIDATE_SECRET=any_random_string

# Optional, dev only: force a date for Grand Tour logic (ISO 8601, e.g. 2026-07-14)
# NEXT_PUBLIC_DEV_GT_FORCE_DATE=
